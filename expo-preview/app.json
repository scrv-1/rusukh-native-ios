{
  "expo": {
    "name": "رُسوخ",
    "slug": "rusukh",
    "owner": "svrvs-team",
    "scheme": "rusukh",
    "version": "0.5.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#101011",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rusukh.study",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "plugins": [
      "expo-document-picker",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "يسجل رُسوخ صوت المحاضرة بإذنك ويحفظه محليًا.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "اختر صورة دراسية لحفظها في رُسوخ.",
          "cameraPermission": "التقط صورة دراسية لحفظها على جهازك.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false,
          "enableRemoteNotifications": false
        }
      ],
      "expo-asset",
      "expo-updates"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/REPLACE_WITH_EAS_PROJECT_ID",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "appVersion": "0.5.2",
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
